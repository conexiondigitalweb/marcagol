# API Football (via RapidAPI) - https://rapidapi.com/api-sports/api/api-football
VITE_API_FOOTBALL_KEY=your_rapidapi_key_here
VITE_API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# World Cup 2026 league ID on api-football.com
VITE_WORLD_CUP_LEAGUE_ID=22
VITE_WORLD_CUP_SEASON=2026

# Set to "true" to use mock data instead of live API
VITE_USE_MOCK_DATA=true
